# ---------------------------------------------------------------------------
# Variables de entorno de la INTERFAZ
# ---------------------------------------------------------------------------
#
# NINGÚN valor de este archivo es real.
#
# `NUXT_API_BASE` es configuración PRIVADA: solo la usa el servidor de Nuxt,
# para saber a qué dirección interna reenviar las peticiones. Nunca debe
# exponerse al navegador, porque revela la dirección de la API.
#
# `NUXT_PUBLIC_BASE` sí es pública: es el origen por el que la gente entra.
# ---------------------------------------------------------------------------

# Dirección interna de la API, desde la red de Docker.
NUXT_API_BASE=http://api:8080

# Origen público de entrada.
NUXT_PUBLIC_BASE=http://localhost:3000

# Desactiva la telemetría de Nuxt en cualquier entorno.
NUXT_TELEMETRY_DISABLED=1
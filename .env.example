# ---------------------------------------------------------------------------
# Variables de entorno del COLEGIO (para `docker compose`)
# ---------------------------------------------------------------------------
#
# Esta plantilla la usan los dos compose:
#
#   docker compose -f deploy/docker-compose.dev.yml  --env-file .env up -d
#   docker compose -f deploy/docker-compose.prod.yml --env-file .env.prod up -d
#
# En producción se copia a `.env.prod`, que NO se versiona.
#
# NINGÚN valor de este archivo es real. Los secretos se generan con:
#
#   openssl rand -base64 48   # para APP_KEY
#   php artisan key:generate --show
#   openssl rand -base64 60 | tr -d '\n'   # para AUTHENTIK_SECRET_KEY
#   openssl rand -hex 32                   # para AUTHENTIK_BOOTSTRAP__TOKEN
#
# Ojo: PostgreSQL no acepta contraseñas de más de 99 caracteres
# (limitación documentada por Authentik).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Aplicación
# ---------------------------------------------------------------------------
APP_ENV=local
APP_KEY=
APP_URL=http://localhost:8000
APP_WEB_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Base de datos del COLEGIO
# ---------------------------------------------------------------------------
# El rol de esta conexión NO puede ser superusuario ni tener BYPASSRLS.
# Con cualquiera de las dos, PostgreSQL ignora las politicas de Row Level
# Security y un colegio podria ver los datos de otro. Lo comprueba:
#   php artisan colegio:verificar-aislamiento
DB_DATABASE=colegio
DB_USERNAME=colegio_app
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Rol de arranque de PostgreSQL
# ---------------------------------------------------------------------------
# El rol de arriba es el de la APLICACION. Este es el de arranque: la imagen
# oficial lo crea como superusuario, asi que la aplicacion NUNCA conecta con el.
# Con superusuario, PostgreSQL ignora las politicas de Row Level Security y una
# empresa podria ver los datos de otra. Los dos detalles, en docs/03.
DB_ADMIN_USERNAME=colegio_admin
DB_ADMIN_PASSWORD=

DB_HOST=postgres
DB_PORT=5432

# Solo en produccion: Redis exige contrasena en el compose de produccion.
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Authentik (proveedor de identidad)
# ---------------------------------------------------------------------------
AUTHENTIK_SECRET_KEY=
AUTHENTIK_BOOTSTRAP__EMAIL=akadmin@hefestostudio.cl
AUTHENTIK_BOOTSTRAP__PASSWORD=
AUTHENTIK_BOOTSTRAP__TOKEN=

# Base de datos propia de Authentik (no es la del colegio).
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__PASSWORD=

# Valores que consume la API (config/authentik.php).
AUTHENTIK_ISSUER=https://id.ejemplo.cl/application/o/colegio/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
AUTHENTIK_SCOPES=openid profile email
AUTHENTIK_GRUPO_ADMIN=colegio-direccion
AUTHENTIK_ALGORITMO=RS256

# ---------------------------------------------------------------------------
# Ajustes de la aplicación (config/colegio.php)
# ---------------------------------------------------------------------------

# Retención de la bitácora de accesos, en horas. 8760 = un año.
# La decisión final sobre cuánto tiempo conservar es del colegio, con su
# asesoría legal. Ver docs/08.
COLEGIO_RETENCION_BITACORA_HORAS=8760

# Qué roles pueden LEER el registro de incidentes de conducta.
# Es deliberadamente configurable: en un colegio chico la dirección y la
# orientadora suelen ser la misma persona, y si el rol quedara fijo en el
# código esa persona podría registrar un incidente y no poder leerlo.
# Ver docs/03, seccion "Modelo de permisos".
COLEGIO_ROLES_CONDUCTA=direccion,orientacion,docente

# Techo de tamaño de página.
COLEGIO_POR_PAGINA_MAXIMO=100

# ---------------------------------------------------------------------------
# Certificados
# ---------------------------------------------------------------------------
ACME_EMAIL=admin@hefestostudio.cl

# ---------------------------------------------------------------------------
# Solo produccion: imagenes construidas
# ---------------------------------------------------------------------------
# En produccion el compose usa imagenes ya construidas (no `build`), para que
# el despliegue sea reproducible y no dependa de que el codigo fuente este en
# el servidor.
# API_IMAGE=hefesto/colegio-api:1.0.0
# WEB_IMAGE=hefesto/colegio-web:1.0.0